{
  "name": "tankscript",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "workspaces": ["backend"],
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && node index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --testPathIgnorePatterns=/tests/integration/",
    "test:unit": "jest tests/unit",
    "test:runner": "node --test tests/unit/tanks/quickjsTankRuntime.test.mjs tests/unit/tanks/quickjsBattleRunner.test.mjs",
    "test:backend-runner": "node --test tests/unit/backend/tankRunner.test.mjs",
    "test:backend-runner:docker": "node --test --test-concurrency=1 tests/docker/tankRunner.test.mjs tests/docker/backendBattle.test.mjs",
    "bench:backend-runner": "node backend/tank-runner/benchmark.js",
    "test:engine": "jest tests/unit/engine",
    "test:frontend": "jest tests/unit/frontend",
    "test:integration": "node tests/runIntegration.js",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=/tests/integration/"
  },
  "type": "module",
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "supertest": "^7.3.1",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "bootstrap": "^5.3.8",
    "monaco-editor": "0.57.0",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  }
}
